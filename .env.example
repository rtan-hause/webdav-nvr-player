# Copy to .env and fill in. `make run` and `docker compose up` both read it.
# .env is ignored by git. Values are read by a shell, so wrap anything with
# spaces, quotes or $ in single quotes.

# --- WebDAV server holding the camera uploads (read-only access is enough) ---
WEBDAV_URL=https://sftpgo.example.com/dav/
WEBDAV_USERNAME=nvr
WEBDAV_PASSWORD=
# Or read the password from a file instead (e.g. a mounted secret):
# WEBDAV_PASSWORD_FILE=/run/secrets/webdav_password

# Folder inside the WebDAV share where the camera's date folders (2026/11/06/...) start.
WEBDAV_ROOT=/

# --- Cameras ---
# How file names and folders are laid out. Supported: reolink
CAMERA_PROFILE=reolink
# Time zone the cameras use in their file names (IANA name).
CAMERA_TZ=America/Los_Angeles

# --- Indexing ---
# Shared secret for the upload webhook (POST /api/ingest, header X-NVR-Secret).
# Leave empty to turn the webhook off and rely on rescans. Make one with: openssl rand -hex 24
# See openwiki/integrations/upload-webhook.md for wiring it to SFTPGo's Event Manager.
INGEST_SECRET=
# How often to rescan today's and yesterday's folders, and to crawl everything.
SCAN_INTERVAL=5m
FULL_SCAN_INTERVAL=24h
# Clips probed / thumbnails made at the same time.
INGEST_WORKERS=2
# ffmpeg grabs a frame for clips without a camera snapshot.
FFMPEG_PATH=ffmpeg

# --- Sign-in ---
# password (default): one user, "admin". On first start the server makes a
#   random password and prints it in its log. Change it in Settings; if it's
#   lost, `make reset-password` (or `nvr reset-password`) prints a new one.
# oidc: sign in through an OpenID Connect provider (Zitadel, Authentik,
#   Keycloak, Google...). Register the redirect URL PUBLIC_URL/auth/oidc/callback.
# none: no sign-in. Only behind a proxy that already signs people in.
AUTH=password
# Where people open the app. Required for oidc; also makes cookies Secure on https.
PUBLIC_URL=
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=          # or OIDC_CLIENT_SECRET_FILE; leave empty for a PKCE-only public client
# OIDC_SCOPES=openid email profile
# OIDC_PROVIDER_NAME=Zitadel   # label on the sign-in button

# --- Server ---
PORT=8080
# Index database (SQLite) and thumbnails. Docker ignores this and uses the /data volume.
DATA_DIR=./data
# Use Postgres instead of SQLite, e.g. postgres://nvr:password@db:5432/nvr?sslmode=disable
DATABASE_URL=
# debug, info, warn or error
LOG_LEVEL=info

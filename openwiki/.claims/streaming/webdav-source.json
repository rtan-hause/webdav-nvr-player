  "claims": [
    {
      "id": "claim_42646a485d5f44cf92795ef890c85a8c",
      "statement": "The WebDAV client is read-only: it lists via PROPFIND, stats, fetches small files, reads ranges and passes GET/HEAD through, never writing to the server.",
      "evidence": [
        {
          "resource": "repo://internal/source/webdav/webdav.go#L1-L3",
          "version": "repo-lines-v1:sha256:76fdf360ab45eb3698adca50015fbf6ff6f06aff4fc046293ad5a5dd11766241:"
        }
      ]
    },
    {
      "id": "claim_44133f4cd73740d3ac7f5003cab0aebd",
      "statement": "All client paths are relative to a base URL formed from the share URL plus WEBDAV_ROOT, and file URLs are escaped per segment so names with spaces work.",
      "evidence": [
        {
          "resource": "repo://internal/source/webdav/webdav.go#L44-L66",
          "version": "repo-lines-v1:sha256:5e8c534bfd026560e90088d92659ed04a497616c771141b7fe2dadb3bb40c62a:"
        }
      ]
    },
    {
      "id": "claim_b2842a56b7084bdfa7ab2281977408dc",

{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "webdav": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^(https?://.+)?$" },
        "root": { "type": "string" },
        "existingSecret": { "type": "string" },
        "usernameKey": { "type": "string" },
        "passwordKey": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "enum": ["reolink"] },
        "timeZone": { "type": "string", "minLength": 1 }
      }
    },
    "indexing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webhookSecret": { "type": "string" },
        "existingSecret": { "type": "string" },
        "webhookSecretKey": { "type": "string" },
        "scanInterval": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
        "fullScanInterval": { "type": "string", "pattern": "^[0-9]+(m|h)$" },
        "workers": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["password", "oidc", "none"] },
        "publicURL": { "type": "string", "pattern": "^(https?://[^/]+/?)?$" },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": { "type": "string" },
            "clientID": { "type": "string" },
            "clientSecret": { "type": "string" },
            "existingSecret": { "type": "string" },
            "clientSecretKey": { "type": "string" },
            "scopes": { "type": "string" },
            "providerName": { "type": "string" }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^(postgres(ql)?://.+)?$" },
        "existingSecret": { "type": "string" },
        "urlKey": { "type": "string" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" } },
        "size": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "logLevel": { "enum": ["debug", "info", "warn", "error"] },
    "env": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "ingress": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resources": { "type": "object" }
  }
}
